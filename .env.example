# Fitgram environment variables
# Copy to .env (never commit .env)

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Sign-In
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_URL_SCHEME=

# Subscriptions
# Current app build uses native StoreKit products:
# fitgram_premium_monthly and fitgram_premium_yearly.
REVENUECAT_API_KEY=

# Cloudflare Worker (AI proxy)
WORKER_BASE_URL=

# Observability (optional during dev)
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.posthog.com

# Apple
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=app.fitgram.ios.bashyrov
