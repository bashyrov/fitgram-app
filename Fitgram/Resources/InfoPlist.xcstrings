        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram використовує мікрофон, щоб швидко додавати страви голосом."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram saves generated cards (such as your streak) to your photo library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram guarda las tarjetas generadas (por ejemplo, tu racha) en tu fototeca."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram zapisuje wygenerowane karty (np. seria) do Twojej biblioteki zdjęć."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram сохраняет созданные карточки (например, серию) в твою медиатеку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram зберігає створені картки (наприклад, серію) у твою фототеку."
          }
        }
      }
    },
