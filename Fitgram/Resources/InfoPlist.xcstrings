    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram uses the camera to recognise your meals from photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram usa la cámara para reconocer tus comidas en fotos."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram używa aparatu, żeby rozpoznawać Twoje posiłki na zdjęciach."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram использует камеру, чтобы распознавать твои блюда на фото."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram використовує камеру, щоб розпізнавати ваші страви на фото."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram reads your weight, workouts and activity from Apple Health to keep your plan up to date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram lee tu peso, entrenamientos y actividad de Apple Health para mantener tu plan al día."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram odczytuje wagę, treningi i aktywność z Apple Health, aby aktualizować Twój plan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram читает вес, тренировки и активность из Apple Health, чтобы обновлять твой план."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram зчитує вагу, тренування й активність з Apple Health, щоб оновлювати твій план."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram only reads from Apple Health and never writes your data there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram solo lee de Apple Health y nunca escribe tus datos allí."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram tylko odczytuje dane z Apple Health i nigdy ich tam nie zapisuje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram только читает данные из Apple Health и никогда не записывает их туда."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitgram лише зчитує дані з Apple Health і ніколи не записує їх туди."
          }
        }
      }
    },
