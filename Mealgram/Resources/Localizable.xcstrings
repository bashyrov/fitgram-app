    "To bardzo intensywne tempo. Trwałe rezultaty przy 0,25-0,5 kg/tydzień. Skonsultuj z dietetykiem.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That’s a very intense pace. Sustainable results come at 0.25–0.5 kg/week. Consult a dietitian."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un ritmo muy intenso. Los resultados duraderos están en 0,25–0,5 kg/semana. Consulta con un dietista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очень интенсивный темп. Устойчивые результаты — 0,25–0,5 кг/неделю. Проконсультируйся с диетологом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це дуже інтенсивний темп. Стійкі результати — 0,25–0,5 кг/тиждень. Порадьтеся з дієтологом."
          }
        }
      }
    },
