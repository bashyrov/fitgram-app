          "stringUnit": {
            "state": "translated",
            "value": "Objetivo: +0,25 – 0,5 kg/semana"
          }
        }
      }
    },
    "Powyżej 0.5 kg/tydz proporcje tłuszcz:mięsień psują się. Zbyt wolno (0 kg) = za mały surplus. Skoryguj kalorie co 2 tygodnie.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powyżej 0.5 kg/tydz proporcje tłuszcz:mięsień psują się. Zbyt wolno (0 kg) = za mały surplus. Skoryguj kalorie co 2 tygodnie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above 0.5 kg/week the fat-to-muscle ratio breaks down. Too slow (0 kg) = surplus too small. Tune calories every 2 weeks."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Понад 0,5 кг/тиждень пропорція жир:м'язи погіршується. Занадто повільно (0 кг) = малий профіцит. Кориguj калорії кожні 2 тижні."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свыше 0,5 кг/нед пропорция жир:мышцы портится. Слишком медленно (0 кг) = слабый профицит. Корректируй калории каждые 2 недели."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por encima de 0,5 kg/semana la proporción grasa:músculo se rompe. Demasiado lento (0 kg) = superávit insuficiente. Ajusta calorías cada 2 semanas."
          }
        }
      }
    },
    "Progresywne przeciążenie": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresywne przeciążenie"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progressive overload"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресивне перевантаження"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогрессирующая перегрузка"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrecarga progresiva"
          }
        }
      }
    },
    "Bez stopniowego dodawania ciężaru lub powtórzeń mięśnie nie mają powodu rosnąć. Notuj. Cel: co tydzień więcej kilo lub powtórzeń niż tydzień wcześniej.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez stopniowego dodawania ciężaru lub powtórzeń mięśnie nie mają powodu rosnąć. Notuj. Cel: co tydzień więcej kilo lub powtórzeń niż tydzień wcześniej."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without gradually adding weight or reps, muscles have no reason to grow. Keep a log. Goal: more weight or reps every week than the week before."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без поступового додавання ваги чи повторів у м'язів немає причини рости. Веди записи. Ціль: щотижня більше кіло чи повторів, ніж тиждень тому."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без постепенного добавления веса или повторов у мышц нет причин расти. Веди дневник. Цель: каждую неделю больше кило или повторов, чем неделей раньше."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin sumar peso o repeticiones de a poco, los músculos no tienen razón para crecer. Lleva registro. Meta: cada semana más peso o más reps que la anterior."
          }
        }
      }
    },
    "Rozłóż białko na 4 dawki": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozłóż białko na 4 dawki"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spread protein across 4 servings"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розподіли білок на 4 порції"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раздели белок на 4 порции"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reparte la proteína en 4 raciones"
          }
        }
      }
    },
    "120 g w jednym posiłku trawi się tak samo jak 30 g — nadmiar nie buduje więcej mięśni. 4 dawki po 30 g aktywują syntezę 4 razy.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "120 g w jednym posiłku trawi się tak samo jak 30 g — nadmiar nie buduje więcej mięśni. 4 dawki po 30 g aktywują syntezę 4 razy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "120 g in one meal digests the same as 30 g — the excess doesn't build extra muscle. 4 servings of 30 g trigger synthesis 4 times."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "120 г за один прийом перетравлюються так само, як 30 г — надлишок не будує більше м'язів. 4 порції по 30 г запускають синтез 4 рази."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "120 г за один приём усваиваются так же, как 30 г — излишек не строит больше мышц. 4 порции по 30 г запускают синтез 4 раза."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "120 g en una sola comida se digieren igual que 30 g — el exceso no construye más músculo. 4 raciones de 30 g disparan la síntesis 4 veces."
          }
        }
      }
    },
    "Cykl mass / cut": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
