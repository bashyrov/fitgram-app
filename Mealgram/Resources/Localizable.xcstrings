          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "500 ml de agua fría (4°C) gastan ≈25 kcal en calentarse al cuerpo. 2 L/día = 100 kcal \"gratis\". Bonito, pero no salva la dieta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
