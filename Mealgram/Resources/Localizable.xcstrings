    "Dodaj cel jak \"Maraton w czerwcu\" albo \"Bez fast-food przez 30 dni\" — Mealgram pomoże Ci go pilnować.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a goal like \"Marathon in June\" or \"No fast-food for 30 days\" — Mealgram will help you keep it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un objetivo como \"Maratón en junio\" o \"Sin comida rápida 30 días\" — Mealgram te ayuda a cumplirlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавь цель вроде «Марафон в июне» или «Без фастфуда 30 дней» — Mealgram поможет её держать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додай ціль на кшталт «Марафон у червні» чи «Без фастфуду 30 днів» — Mealgram допоможе її тримати."
          }
        }
      }
    },
