    "Schoenfeld's meta-analysis (2016): 2x is better than 1x for hypertrophy. Chest, back, legs — training each 2 times a week yields optimal growth.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schoenfeld's 2016 meta: 2× per week beats 1× for hypertrophy. Chest, back, legs — twice a week each is optimal for growth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El metaanálisis de Schoenfeld (2016): 2× por semana mejor que 1× para hipertrofia. Pecho, espalda, piernas — cada uno dos veces a la semana es óptimo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta Schoenfelda (2016): 2x lepsze niż 1x dla hipertrofii. Klatka, plecy, nogi — każde 2 razy w tygodniu daje optymalny wzrost."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мета-анализ Schoenfeld (2016): 2 раза в неделю лучше 1 для гипертрофии. Грудь, спина, ноги — каждое 2× в неделю — оптимальный рост."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Метааналіз Schoenfeld (2016): 2 рази на тиждень кращі за 1 для гіпертрофії. Груди, спина, ноги — кожне 2× на тиждень — оптимальний ріст."
          }
        }
      }
    },
