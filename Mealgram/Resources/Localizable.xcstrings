    "Po toalecie, przed wypiciem czegokolwiek, na tej samej wadze. Powtarzalność procedury jest ważniejsza niż samo urządzenie.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po toalecie, przed wypiciem czegokolwiek, na tej samej wadze. Powtarzalność procedury jest ważniejsza niż samo urządzenie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the toilet, before drinking anything, on the same scale. The repeatability of the routine matters more than the device itself."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після туалету, до того, як щось вип'єш, на тих самих вагах. Повторюваність процедури важливіша за сам пристрій."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После туалета, до того как что-то выпьешь, на одних и тех же весах. Повторяемость процедуры важнее самого устройства."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después del baño, antes de beber nada, en la misma báscula. La repetibilidad del proceso importa más que el aparato."
          }
        }
      }
    },
