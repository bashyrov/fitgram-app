    "Wspieramy, świętujemy progres — nie oceniamy potknięć": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We support, celebrate progress — never judge slips"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoyamos, celebramos el progreso — no juzgamos los tropiezos"
          }
