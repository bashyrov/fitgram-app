    "Aim for 1.5-2 g of protein per kg of body weight — cottage cheese, eggs, chicken, lentils keep muscle while fat goes.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim for 1.5-2 g of protein per kg of body weight — cottage cheese, eggs, chicken, lentils keep muscle while fat goes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta a 1.5-2 g de proteína por kg de peso corporal — el queso cottage, huevos, pollo y lentejas mantienen el músculo mientras se pierde grasa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Celuj w 1.5-2 g białka na kg masy ciała — twaróg, jajka, kurczak, soczewica chronią mięśnie podczas redukcji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стремитесь к 1.5-2 г белка на кг веса — творог, яйца, курица, чечевица сохранят мышцы при уходе жира."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орієнтуйтеся на 1.5-2 г білка на кг маси тіла — кисломолочний сир, яйця, курка, сочевиця зберігають м'язи, поки йде жир."
          }
        }
      }
    },
    "Aim for 35 g at breakfast — keeps lunch cravings calmer.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim for 35 g at breakfast — keeps lunch cravings calmer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta a 35 g en el desayuno — calma el hambre del almuerzo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Celuj w 35 g na śniadanie — uspokaja głód do obiadu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цельтесь в 35 г на завтрак — успокаивает голод до обеда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цілься в 35 г на сніданок — стримує апетит до обіду."
          }
        }
      }
    },
    "Aim the whole plate into the center of the frame": {
      "localizations": {
