          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To bardzo intensywne tempo. Trwałe rezultaty przy 0,25-0,5 kg/tydzień. Skonsultuj z dietetykiem."
          }
        },
        "ru": {
