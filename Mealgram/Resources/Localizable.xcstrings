    "Brakuje %lld g białka do celu. Twaróg, jajka, strączki — pasują niemal do każdego posiłku.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld g of protein short of your goal. Cottage cheese, eggs, legumes — fit almost any meal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te faltan %lld g de proteína. Requesón, huevos, legumbres — encajan en casi cualquier comida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не хватает %lld г белка до цели. Творог, яйца, бобовые — подойдут почти к любому приёму пищи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
