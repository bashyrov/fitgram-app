    "Twój plan: %lld kcal dziennie, %lld g białka. Lekka nadwyżka — masa głównie z mięśni.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan: %1$lld kcal daily, %2$lld g protein. Light surplus — mass mainly from muscle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu plan: %1$lld kcal diarias, %2$lld g de proteína. Superávit ligero — masa principalmente muscular."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "new",
            "value": "Twój plan: %1$lld kcal dziennie, %2$lld g białka. Lekka nadwyżka — masa głównie z mięśni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой план: %1$lld ккал в день, %2$lld г белка. Лёгкий профицит — масса в основном из мышц."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твій план: %1$lld ккал на день, %2$lld г білка. Легкий профіцит — маса переважно з м'язів."
          }
        }
      }
    },
    "Twój plan: %lld kcal dziennie, %lld g białka. To bezpieczne tempo na zrównoważone odchudzanie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan: %1$lld kcal daily, %2$lld g protein. A safe pace for balanced weight loss."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu plan: %1$lld kcal diarias, %2$lld g de proteína. Un ritmo seguro para perder peso de forma equilibrada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "new",
            "value": "Twój plan: %1$lld kcal dziennie, %2$lld g białka. To bezpieczne tempo na zrównoważone odchudzanie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой план: %1$lld ккал в день, %2$lld г белка. Безопасный темп для сбалансированного похудения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твій план: %1$lld ккал на день, %2$lld г білка. Безпечний темп для збалансованого схуднення."
          }
        }
      }
    },
    "Twój plan: %lld kcal dziennie. Cel — utrzymać wagę i zbudować zdrowe nawyki.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan: %lld kcal a day. Goal — maintain weight and build healthy habits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu plan: %lld kcal al día. Objetivo — mantener peso y crear hábitos sanos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой план: %lld ккал в день. Цель — удержать вес и сформировать здоровые привычки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
