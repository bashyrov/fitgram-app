    "Domyślnie nie udostępniamy nic. Włącz tylko to, co naprawdę chcesz pokazać znajomym.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default we share nothing. Enable only what you really want friends to see."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto no compartimos nada. Activa solo lo que realmente quieras mostrar a amigos."
