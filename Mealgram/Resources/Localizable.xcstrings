    "Profil → Konto → Usuń konto. Wszystkie lokalne dane znikają natychmiast; serwerowe (gdy ruszy backend) — w ciągu 72 godzin.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile → Account → Delete account. All local data disappears instantly; server data (when backend starts) — within 72 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfil → Cuenta → Eliminar cuenta. Todos los datos locales desaparecen de inmediato; los del servidor (cuando se active el backend), en 72 horas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil → Konto → Usuń konto. Wszystkie lokalne dane znikają natychmiast; serwerowe (gdy ruszy backend) — w ciągu 72 godzin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль → Аккаунт → Удалить аккаунт. Все локальные данные удаляются мгновенно; серверные (когда запустится бэкенд) — в течение 72 часов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профіль → Акаунт → Видалити акаунт. Усі локальні дані видаляються миттєво; дані з сервера (коли запрацює бекенд) — протягом 72 годин."
          }
        }
      }
    },
