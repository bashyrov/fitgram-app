    "Powiedz na przykład: „zjadłam zupę pomidorową i kanapkę z serem”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say, for example: \"I ate tomato soup and a cheese sandwich\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di, por ejemplo: \"comí sopa de tomate y un sándwich de queso\"."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz na przykład: „zjadłam zupę pomidorową i kanapkę z serem”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажи, например: «съела томатный суп и бутерброд с сыром»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажіть, наприклад: «з’їла томатний суп і канапку із сиром»."
          }
        }
      }
    },
    "Powiedz nazwę jedzenia, np. „500 g ryżu i 200 g sera”. Dopiero wtedy pokażemy regulację gramów.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say the food name, e.g. “500 g rice and 200 g cheese”. Only then will we show gram adjustment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di el alimento, por ejemplo “500 g de arroz y 200 g de queso”. Solo entonces mostraremos el ajuste de gramos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz nazwę jedzenia, np. „500 g ryżu i 200 g sera”. Dopiero wtedy pokażemy regulację gramów."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назови еду, например “500 г риса и 200 г сыра”. Только тогда покажем настройку граммов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назви їжу, напр. “500 г рису і 200 г сиру”. Лише тоді покажемо налаштування грамів."
          }
        }
      }
    },
