    "Brak znajomych. Dodaj kogoś, żeby zobaczyć jego streak i odznaki.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No friends. Add someone to see their streak and badges."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin amigos. Añade a alguien para ver su racha e insignias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет друзей. Добавь кого-то, чтобы увидеть серию и значки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає друзів. Додай когось, щоб побачити їх серію та відзнаки."
          }
        }
      }
    },
    "Brakuje %lld g białka do celu. Twaróg, jajka, strączki — pasują niemal do każdego posiłku.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld g of protein short of your goal. Cottage cheese, eggs, legumes — fit almost any meal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te faltan %lld g de proteína. Requesón, huevos, legumbres — encajan en casi cualquier comida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не хватает %lld г белка до цели. Творог, яйца, бобовые — подойдут почти к любому приёму пищи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бракує %lld г білка до цілі. Кисломолочний сир, яйця, бобові — пасують майже до будь-якої страви."
          }
        }
      }
    },
