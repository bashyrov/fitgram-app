    "Wszystkie wpisy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All entries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las entradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все записи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі записи."
          }
        }
      }
    },
    "Wszystkie wyzwania działają równolegle. Nic nie wybierasz — każdy posiłek liczy się sam.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All challenges run in parallel. You don’t pick anything — every meal counts on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los retos corren a la vez. No eliges nada — cada comida cuenta por sí sola."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все челленджи идут параллельно. Ничего не выбираешь — каждый приём пищи засчитывается сам."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі виклики йдуть паралельно. Нічого не обираєш — кожна страва зараховується сама."
          }
        }
      }
    },
    "Wszystko jest w porządku — nic nie musisz zaznaczać.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything’s fine — you don’t have to tick anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo está bien — no necesitas marcar nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё в порядке — ничего отмечать не нужно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе гаразд — нічого позначати не треба."
          }
        }
      }
    },
    "Wszystko na kursie": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All on track"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo en marcha"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё по курсу"
          }
        },
        "uk": {
