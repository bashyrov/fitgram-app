    "Polska średnia to 17 g. Cel: 30 g dla większości dorosłych. Najprościej: pełne ziarno zamiast białego, warzywa do każdego posiłku, owoc do przekąski.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polska średnia to 17 g. Cel: 30 g dla większości dorosłych. Najprościej: pełne ziarno zamiast białego, warzywa do każdego posiłku, owoc do przekąski."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Polish average is 17 g. Target: 30 g for most adults. Simplest path: whole grain over white, veg in every meal, fruit as a snack."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Польське середнє — 17 г. Ціль: 30 г для більшості дорослих. Найпростіше: цільне зерно замість білого, овочі до кожної страви, фрукт на перекус."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Польское среднее — 17 г. Цель: 30 г для большинства взрослых. Проще всего: цельное зерно вместо белого, овощи к каждой еде, фрукт на перекус."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La media polaca es 17 g. Objetivo: 30 g para la mayoría de adultos. Lo más simple: grano integral en vez de blanco, verdura en cada comida, fruta de snack."
          }
        }
      }
    },
    "Sód: max 2300 mg/dobę": {
      "extractionState": "manual",
      "localizations": {
