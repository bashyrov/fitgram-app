    "Maintenance is a weekly-average game. One above-target day doesn't break it — watch the 7-day picture.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenance is a weekly-average game. One above-target day doesn't break it — watch the 7-day picture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenerse es un juego de promedio semanal. Un día por encima del objetivo no lo arruina todo; mira la imagen de los 7 días."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymanie wagi to gra średnich tygodniowych. Jeden dzień powyżej celu nic nie psuje — patrz na obraz z 7 dni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддержание веса — это игра средних значений за неделю. Один день выше цели ничего не испортит — следите за картиной за 7 дней."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтримка ваги — це гра середньотижневих значень. Один день вище цілі нічого не руйнує — стежте за 7-денною картиною."
          }
        }
      }
    },
