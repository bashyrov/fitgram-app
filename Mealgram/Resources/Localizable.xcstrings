    "+10% TDEE wystarcza, żeby budować ≈0.25 kg mięśni miesięcznie u zaawansowanych, 0.5–0.7 kg u początkujących. Większy nadwyżka = więcej tłuszczu, nie więcej mięśni.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "+10% TDEE wystarcza, żeby budować ≈0.25 kg mięśni miesięcznie u zaawansowanych, 0.5–0.7 kg u początkujących. Większy nadwyżka = więcej tłuszczu, nie więcej mięśni."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "+10% TDEE is enough to build ≈0.25 kg of muscle a month for advanced lifters, 0.5–0.7 kg for beginners. A bigger surplus = more fat, not more muscle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "+10% TDEE достатньо, щоб набирати ≈0,25 кг м'язів на місяць у досвідчених, 0,5–0,7 кг у початківців. Більший профіцит = більше жиру, а не м'язів."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "+10% TDEE достаточно, чтобы набирать ≈0,25 кг мышц в месяц у продвинутых, 0,5–0,7 кг у новичков. Больше профицит = больше жира, а не мышц."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "+10% del TDEE basta para construir ≈0,25 kg de músculo al mes en avanzados, 0,5–0,7 kg en principiantes. Más superávit = más grasa, no más músculo."
          }
        }
      }
    },
    "1.6 g białka/kg = sweet spot": {
