    "Black espresso is ≈2 kcal. Each teaspoon of sugar is +20 kcal, a tablespoon of milk is +10, syrup is +60. Three \"small\" coffees a day can consume 300 kcal.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain espresso is ≈2 kcal. Each teaspoon of sugar +20 kcal, splash of milk +10, syrup +60. Three \"small\" coffees a day can eat 300 kcal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espresso solo son ≈2 kcal. Cada cucharadita de azúcar +20 kcal, un chorrito de leche +10, sirope +60. Tres cafés \"pequeños\" al día pueden sumar 300 kcal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Espresso bez dodatków to ≈2 kcal. Każda łyżeczka cukru +20 kcal, łyżka mleka +10, syrop +60. Trzy „małe” kawy dziennie potrafią zjeść 300 kcal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эспрессо без добавок — ≈2 ккал. Каждая чайная ложка сахара +20 ккал, ложка молока +10, сироп +60. Три «маленьких» кофе в день съедают 300 ккал."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Еспресо без добавок — це ≈2 ккал. Кожна ложечка цукру +20 ккал, ложка молока +10, сироп +60. Три «маленькі» кави на день можуть з'їсти 300 ккал."
          }
        }
      }
    },
