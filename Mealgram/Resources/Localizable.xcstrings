        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se ve sano. No olvides el agua — suele ser la pieza que falta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko wygląda zdrowo. Nie zapominaj o wodzie — to często prosty brakujący puzzel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
