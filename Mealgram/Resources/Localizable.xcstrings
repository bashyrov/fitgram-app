    "Women 320 mg, men 420 mg. Deficiency = cramps, insomnia, heart palpitations. Pumpkin seeds (550 mg/100 g), cocoa, almonds, dark chocolate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Women 320, men 420 mg. Deficiency = cramps, insomnia, palpitations. Pumpkin seeds (550 mg/100 g), cocoa, almonds, dark chocolate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mujeres 320, hombres 420 mg. Déficit = calambres, insomnio, palpitaciones. Pipas de calabaza (550 mg/100 g), cacao, almendras, chocolate negro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobiety 320, mężczyźni 420 mg. Niedobór = skurcze, bezsenność, kołatanie serca. Pestki dyni (550 mg/100 g), kakao, migdały, gorzka czekolada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Женщины 320, мужчины 420 мг. Дефицит = судороги, бессонница, сердцебиение. Тыквенные семечки (550 мг/100 г), какао, миндаль, тёмный шоколад."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жінки 320, чоловіки 420 мг. Дефіцит = судоми, безсоння, серцебиття. Гарбузове насіння (550 мг/100 г), какао, мигдаль, чорний шоколад."
          }
        }
      }
    },
    "Women of childbearing age need 18 mg of iron per day, men need 10. Red meat, liver, lentils + vitamin C increase absorption.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Women of reproductive age need 18 mg of iron daily, men 10. Red meat, liver, lentils + vitamin C boost absorption."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mujeres en edad reproductiva necesitan 18 mg de hierro al día, los hombres 10. Carne roja, hígado, lentejas + vitamina C suben la absorción."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobiety w wieku rozrodczym potrzebują 18 mg żelaza dziennie, mężczyźni 10. Czerwone mięso, wątroba, soczewica + witamina C zwiększają wchłanianie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Женщинам репродуктивного возраста нужно 18 мг железа в день, мужчинам 10. Красное мясо, печень, чечевица + витамин С усиливают усвоение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жінкам у репродуктивному віці треба 18 мг заліза щодня, чоловікам 10. Червоне м'ясо, печінка, сочевиця + вітамін С підвищують засвоєння."
          }
        }
      }
    },
