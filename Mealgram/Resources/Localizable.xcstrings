    "Twoja waga zaktualizuje się w profilu, a my przeliczymy normy dzienne (jeśli nie są zablokowane).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your weight updates in the profile and we recalculate daily targets (unless locked)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peso se actualiza en el perfil y recalculamos los objetivos diarios (salvo que estén fijados)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой вес обновится в профиле, и мы пересчитаем дневные нормы (если они не зафиксированы)."
          }
        },
        "uk": {
