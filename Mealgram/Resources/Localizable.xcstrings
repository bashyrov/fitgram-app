    "Eggs, white sausage, sour rye soup, mazurek, bundt cake. It's easy to exceed your daily goal — log them as you go.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eggs, white sausage, żurek, mazurek, babka. It's easy to overshoot the daily goal — log as you eat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Huevos, salchicha blanca, żurek, mazurek, babka. Es fácil pasarse del objetivo — registra al momento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jajka, biała kiełbasa, żurek, mazurek, babka. Łatwo przekroczyć dzienny cel — wpisuj na bieżąco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Яйца, белая колбаса, журек, мазурок, бабка. Легко превысить дневную норму — записывай сразу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Яйця, біла ковбаса, журек, мазурок, бабка. Легко перевищити денну норму — записуй одразу."
          }
        }
      }
    },
