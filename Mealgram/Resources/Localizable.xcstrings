    "Hawthorne effect: the awareness of being measured improves results. Scanning meals reduces intake by 5-10% without a conscious diet. Data has power.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hawthorne effect: the awareness of being measured improves results. Scanning meals reduces intake by 5-10% without a conscious diet. Data has power."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Efecto Hawthorne: saber que te miden mejora los resultados. Registrar las comidas reduce la ingesta un 5-10% sin hacer dieta consciente. Los datos tienen poder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Efekt Hawthorne'a: świadomość bycia mierzonym poprawia wyniki. Skanowanie posiłków zmniejsza spożycie o 5-10% bez świadomej diety. Dane mają moc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эффект Хоторна: осознание того, что вас измеряют, улучшает результаты. Сканирование блюд снижает потребление на 5-10% без сознательной диеты. Данные обладают силой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ефект Хоторна: усвідомлення того, що вас вимірюють, покращує результати. Сканування страв знижує споживання на 5-10% без свідомої дієти. Дані мають силу."
          }
        }
      }
    },
