    "Pierwszy krok: zaloguj dzisiejsze śniadanie. Spróbuj skanu zdjęciem — to najszybszy sposób.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First step: log today’s breakfast. Try a photo scan — it’s the fastest way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primer paso: registra el desayuno de hoy. Prueba el escaneo por foto — es lo más rápido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первый шаг: залогируй сегодняшний завтрак. Попробуй фотоскан — это самый быстрый способ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перший крок: зафіксуйте сьогоднішній сніданок. Спробуйте фотоскан — це найшвидше."
          }
        }
      }
    },
