        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is editable. This is just a demo — nothing is saved to Today yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo es editable. Esto es solo una demostración; aún no se ha guardado nada en Hoy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko jest edytowalne. To tylko demo — nic nie trafia jeszcze do Dziś."
          }
