    "Clear borscht is beetroot broth — filling, low-calorie, rich in nitrates that support blood pressure. An ideal pre-breakfast or pre-meal drink.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear borscht is a beet broth — filling, low-cal, rich in nitrates that support blood pressure. Perfect as a pre-breakfast or pre-meal starter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El borscht clarito es un caldo de remolacha — saciante, bajo en kcal, rico en nitratos que ayudan a la tensión. Ideal antes del desayuno o como entrante."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czysty barszcz to bulion z buraka — sycący, niskokaloryczny, bogaty w azotany wspierające ciśnienie. Idealne przedśniadanie lub przedposiłkowe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чистый борщ — свекольный бульон: сытный, низкокалорийный, богатый нитратами, поддерживающими давление. Идеально перед завтраком или перед едой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чистий борщ — буряковий бульйон: ситний, низькокалорійний, багатий на нітрати, які підтримують тиск. Ідеально перед сніданком або перед прийомом їжі."
          }
        }
      }
    },
