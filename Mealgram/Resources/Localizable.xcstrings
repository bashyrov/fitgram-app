    "%lld g of protein left to your goal. Cottage cheese, eggs, legumes — they fit almost any meal.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld g of protein left to your goal. Cottage cheese, eggs, legumes — they fit almost any meal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te faltan %lld g de proteína para tu meta. El queso cottage, los huevos y las legumbres van con casi todo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostało %lld g białka do celu. Twaróg, jajka, strączki — pasują do prawie każdego posiłku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осталось %lld г белка до цели. Творог, яйца, бобовые — отличный выбор для любого приема пищи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишилося %lld г білка до вашої цілі. Кисломолочний сир, яйця, бобові — вони підходять майже до будь-якої страви."
          }
        }
      }
    },
