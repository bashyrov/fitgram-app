          }
        }
      }
    },
    "Większa masa mięśniowa + większa objętość pokarmu = większa potrzeba wody. Norma 30 ml/kg, na masie raczej 35–40 ml/kg dla dobrej regeneracji.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Większa masa mięśniowa + większa objętość pokarmu = większa potrzeba wody. Norma 30 ml/kg, na masie raczej 35–40 ml/kg dla dobrej regeneracji."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More muscle mass + bigger meal volume = bigger water need. Baseline is 30 ml/kg; during a bulk aim for 35–40 ml/kg for solid recovery."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більше м'язів + більший обсяг їжі = більша потреба у воді. Норма 30 мл/кг, на масі радше 35–40 мл/кг для гарного відновлення."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше мышц + больший объём еды = больше воды нужно. Норма 30 мл/кг, на массе скорее 35–40 мл/кг для нормального восстановления."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más masa muscular + más volumen de comida = más necesidad de agua. La base son 30 ml/kg; en volumen, mejor 35–40 ml/kg para una buena recuperación."
          }
        }
      }
    },
    "Kazeina przed snem": {
      "extractionState": "manual",
      "localizations": {
