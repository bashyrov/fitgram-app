        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтримуємо, святкуємо прогрес — не засуджуємо невдачі"
          }
        }
      }
    },
    "Wspierasz polskiego solo-developera": {
      "localizations": {
        "en": {
