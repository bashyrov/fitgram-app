    "150 ml czerwonego wytrawnego to ≈120 kcal. Słodkie wino +30%. Z perspektywy redukcji: 1 lampka = 1 godzina spaceru. Wybieraj świadomie.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "150 ml czerwonego wytrawnego to ≈120 kcal. Słodkie wino +30%. Z perspektywy redukcji: 1 lampka = 1 godzina spaceru. Wybieraj świadomie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "150 ml of dry red is ≈120 kcal. Sweet wine adds +30%. In cut terms: 1 glass = 1 hour of walking. Choose consciously."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "150 мл сухого червоного — ≈120 ккал. Солодке вино +30%. У термінах редукції: 1 келих = 1 година прогулянки. Обирай свідомо."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "150 мл сухого красного — ≈120 ккал. Сладкое вино +30%. В терминах редукции: 1 бокал = 1 час прогулки. Выбирай осознанно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "150 ml de tinto seco son ≈120 kcal. El vino dulce suma +30%. En definición: 1 copa = 1 hora de caminata. Elige con cabeza."
          }
        }
      }
    },
    "Białko roślinne — wzajemne uzupełnianie": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
