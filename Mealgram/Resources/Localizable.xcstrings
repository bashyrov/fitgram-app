    "Classic approach: 4–6 months of a lean bulk (+10%), followed by 8–12 weeks of cutting (-15%). This yields a lean physique without looking bloated year-round.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Classic approach: 4–6 months of a lean bulk (+10%), followed by 8–12 weeks of cutting (-15%). This yields a lean physique without looking bloated year-round."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfoque clásico: 4–6 meses de volumen limpio (+10%), seguidos de 8–12 semanas de definición (-15%). Esto logra un físico magro sin verse hinchado todo el año."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasyczne podejście: 4–6 miesięcy czystej masy (+10%), a następnie 8–12 tygodni redukcji (-15%). Daje to estetyczną sylwetkę bez efektu opuchnięcia przez cały rok."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Классический подход: 4–6 месяцев чистого набора (+10%), затем 8–12 недель сушки (-15%). Это дает сухую форму без круглогодичной отечности."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Класичний підхід: 4–6 місяців чистого профіциту (+10%), після чого 8–12 тижнів сушки (-15%). Це дає суху статуру без вигляду набряклості протягом року."
          }
        }
      }
    },
