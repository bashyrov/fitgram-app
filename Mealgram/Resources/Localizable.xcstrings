    "Twoje dane zostaną — przeprowadzimy Cię tylko jeszcze raz przez ustawienia.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data stays — we’ll just walk you through the setup once more."
          }
        },
        "es": {
