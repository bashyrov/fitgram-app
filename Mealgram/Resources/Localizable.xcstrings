    "400 g/day is the WHO minimum. Each color represents different phytochemicals: lycopene (red), beta-carotene (orange), anthocyanins (purple), chlorophyll (green).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "400 g/day — WHO minimum. Each colour means different phytochemicals: lycopene (red), beta-carotene (orange), anthocyanins (purple), chlorophyll (green)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "400 g/día — mínimo OMS. Cada color implica fitoquímicos distintos: licopeno (rojo), betacaroteno (naranja), antocianinas (morado), clorofila (verde)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "400 g/dobę — minimum WHO. Każdy kolor to inne fitozwiązki: lykopen (czerwony), beta-karoten (pomarańczowy), antocyjany (fioletowy), chlorofil (zielony)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "400 г/сут — минимум ВОЗ. Каждый цвет — свои фитосоединения: ликопин (красный), бета-каротин (оранжевый), антоцианы (фиолетовый), хлорофилл (зелёный)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "400 г/добу — мінімум ВООЗ. Кожен колір — інші фітоспоруки: лікопен (червоний), бета-каротин (помаранчевий), антоціани (фіолетовий), хлорофіл (зелений)."
          }
        }
      }
    },
    "5 dni po -400 kcal = -2000 kcal. Dwa dni po +1000 kcal = +2000 kcal. Bilans zerowy. Dlatego waga „nie spada”, mimo idealnego poniedziałku.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 days at -400 kcal = -2000 kcal. Two days at +1000 kcal = +2000 kcal. Net zero. That's why the scale \"won't budge\" despite a perfect Monday."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "5 días a -400 kcal = -2000 kcal. Dos días a +1000 kcal = +2000 kcal. Balance cero. Por eso la báscula \"no baja\" pese al lunes perfecto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "5 dni po -400 kcal = -2000 kcal. Dwa dni po +1000 kcal = +2000 kcal. Bilans zerowy. Dlatego waga „nie spada”, mimo idealnego poniedziałku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "5 дней по -400 ккал = -2000 ккал. Два дня по +1000 ккал = +2000 ккал. Баланс нулевой. Поэтому вес «не падает», несмотря на идеальный понедельник."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "5 днів по -400 ккал = -2000 ккал. Два дні по +1000 ккал = +2000 ккал. Баланс нульовий. Тому вага «не падає», незважаючи на ідеальний понеділок."
          }
        }
      }
    },
    "5 dni w pasie kalorii (±15 %) — bez skrajności.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
