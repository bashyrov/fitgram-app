          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espresso solo son ≈2 kcal. Cada cucharadita de azúcar +20 kcal, un chorrito de leche +10, sirope +60. Tres cafés \"pequeños\" al día pueden sumar 300 kcal."
          }
        }
      }
