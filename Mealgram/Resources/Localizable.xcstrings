    "Jesteś bliska celu. Lekka kolacja albo przekąska — i wystarczy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re close to the goal. A light dinner or snack — and that’s enough."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás cerca del objetivo. Una cena ligera o un snack — y basta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты близко к цели. Лёгкий ужин или перекус — и хватит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви близько до цілі. Легка вечеря чи перекус — і досить."
          }
        }
      }
    },
    "Jeszcze nic dziś nie dodałaś — szybki wpis utrzyma serię.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing logged today yet — a quick entry keeps the streak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no registraste nada hoy — una entrada rápida mantiene la racha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня ещё ничего не добавлено — быстрая запись сохранит серию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні ще нічого не додано — швидкий запис збереже серію."
          }
        }
      }
    },
    "Jeszcze nic dziś nie zapisałaś — dorzuć obiad, żebym mogła ułożyć dzień.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing saved today yet — add lunch so I can shape the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no guardaste nada hoy — añade el almuerzo para que arme el día."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня ещё ничего не сохранено — добавь обед, чтобы я могла спланировать день."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні ще нічого не збережено — додайте обід, щоб я могла спланувати день."
          }
        }
      }
    },
    "Jeszcze nic nie dodałeś. Zacznij od pierwszego posiłku 🌱": {
