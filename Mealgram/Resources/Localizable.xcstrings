    "Krótka notka rano, gdy zaczynasz dzień, i wieczorem, żeby uzupełnić wpisy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short note in the morning when the day starts, and in the evening to complete the log."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nota corta por la mañana al empezar el día y otra por la noche para cerrar el registro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткая заметка утром на старте дня и вечером, чтобы закрыть записи."
