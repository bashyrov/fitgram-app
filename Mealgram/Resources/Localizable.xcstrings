    "Most home-cooked dishes fit in your daily target if portions are sane. Mealgram tracks weight, not your culture.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most home-cooked dishes fit in your daily target if portions are sane. Mealgram tracks weight, not your culture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría de los platos caseros caben en tu objetivo diario si las porciones son sensatas. Mealgram registra el peso, no tu cultura."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Większość domowych dań mieści się w dziennym celu, jeśli porcje są rozsądne. Mealgram śledzi wagę, nie Twoją kulturę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большинство домашних блюд вписываются в дневную норму, если порции разумны. Mealgram считает вес, а не вашу культуру."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більшість домашніх страв вписуються у вашу денну ціль, якщо порції розумні. Mealgram відстежує вагу, а не вашу культуру."
          }
        }
      }
    },
