    "Do budowy masy mięśniowej wystarczy +10–15% TDEE. Większy surplus dokłada głównie tłuszcz, nie mięśnie. Tempo 0.25–0.5% masy tygodniowo to dobry znak.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do budowy masy mięśniowej wystarczy +10–15% TDEE. Większy surplus dokłada głównie tłuszcz, nie mięśnie. Tempo 0.25–0.5% masy tygodniowo to dobry znak."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For muscle growth, +10–15% TDEE is plenty. A bigger surplus mostly adds fat, not muscle. A pace of 0.25–0.5% body mass per week is a good sign."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для нарощування м'язів достатньо +10–15% TDEE. Більший профіцит додає переважно жир, а не м'язи. Темп 0,25–0,5% маси на тиждень — добрий знак."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для роста мышц достаточно +10–15% TDEE. Больший профицит добавляет в основном жир, а не мышцы. Темп 0,25–0,5% массы в неделю — хороший знак."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ganar músculo, basta con +10–15% del TDEE. Un superávit mayor añade sobre todo grasa, no músculo. Un ritmo del 0,25–0,5% del peso por semana es buena señal."
          }
        }
      }
    },
    "Weekend potrafi zjeść tygodniowy deficyt": {
      "extractionState": "manual",
