        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первый шаг: залогируй следующие 3 приёма пищи. Через неделю увидишь первые закономерности."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перший крок: запишіть наступні 3 страви. За тиждень побачите перші закономірності."
          }
        }
      }
    },
