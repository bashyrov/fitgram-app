            "state": "translated",
            "value": "Slower pace usually means longer-lasting results. You can change this later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ritmo más lento suele dar resultados más duraderos. Lo puedes cambiar luego."
