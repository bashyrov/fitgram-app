    "Mnożnik do BMR: 1.2 (siedzący), 1.375 (lekko), 1.55 (umiarkowanie), 1.725 (mocno), 1.9 (sportowo). Większość ludzi przeszacowuje — zacznij od niższego.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mnożnik do BMR: 1.2 (siedzący), 1.375 (lekko), 1.55 (umiarkowanie), 1.725 (mocno), 1.9 (sportowo). Większość ludzi przeszacowuje — zacznij od niższego."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BMR multiplier: 1.2 (sedentary), 1.375 (light), 1.55 (moderate), 1.725 (hard), 1.9 (athlete). Most people overshoot — start at the lower end."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Множник до BMR: 1,2 (сидячий), 1,375 (легкий), 1,55 (помірний), 1,725 (важкий), 1,9 (спортивний). Більшість переоцінює — починай із нижчого."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Множитель к BMR: 1,2 (сидячий), 1,375 (лёгкий), 1,55 (умеренный), 1,725 (тяжёлый), 1,9 (спортивный). Большинство переоценивает — начни с нижнего."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplicador del BMR: 1,2 (sedentario), 1,375 (ligero), 1,55 (moderado), 1,725 (intenso), 1,9 (atleta). La mayoría sobreestima — empieza por el más bajo."
          }
        }
      }
    },
    "1 kg mięśni = +13 kcal/dobę": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
