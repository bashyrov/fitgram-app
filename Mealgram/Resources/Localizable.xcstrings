        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более медленный темп обычно даёт более стойкий эффект. Это можно изменить позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повільніший темп зазвичай дає тривалішу віддачу. Це можна змінити пізніше."
