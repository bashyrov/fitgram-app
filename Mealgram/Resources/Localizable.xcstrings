    "Dynamic joint mobilization + 2-3 light sets of the main exercise. Cutting the warm-up short = +60% risk of injury. You won't save time here.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic joint mobilization + 2-3 light sets of the main exercise. Cutting the warm-up short = +60% risk of injury. You won't save time here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Movilización articular dinámica + 2-3 series ligeras del ejercicio principal. Acortar el calentamiento = +60% de riesgo de lesión. No ahorrarás tiempo aquí."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamiczna mobilizacja stawów + 2-3 lekkie serie ćwiczenia głównego. Skrócenie rozgrzewki = +60% ryzyka kontuzji. Tutaj nie zaoszczędzisz czasu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Динамическая мобилизация суставов + 2-3 легких подхода основного упражнения. Сокращение разминки = +60% к риску травмы. Здесь время не сэкономишь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Динамічна мобілізація суглобів + 2-3 легкі підходи основної вправи. Скорочення розминки = +60% до ризику травми. Тут час не заощадиш."
          }
        }
      }
    },
