    "Raw pork loin is 140 kcal/100 g. After breading in breadcrumbs and frying in lard/oil — 280–320 kcal. Baked in the oven without breading: 180 kcal.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raw pork loin is 140 kcal/100 g. Breaded and fried in lard/oil — 280–320 kcal. Oven-baked without breading: 180 kcal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El lomo de cerdo crudo son 140 kcal/100 g. Empanado y frito en manteca/aceite — 280–320 kcal. Al horno sin empanado: 180 kcal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schab surowy 140 kcal/100 g. Po panierce w bułce i smażeniu w smalcu/oleju — 280–320 kcal. Pieczony w piekarniku bez panierki: 180 kcal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сырая свиная корейка — 140 ккал/100 г. В панировке и жарке на смальце/масле — 280–320 ккал. Запечённая в духовке без панировки: 180 ккал."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сира свиняча корейка — 140 ккал/100 г. У паніровці й смаженні на смальці/олії — 280–320 ккал. Запечена в духовці без паніровки: 180 ккал."
          }
        }
      }
    },
