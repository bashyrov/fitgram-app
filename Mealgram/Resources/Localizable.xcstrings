    "5 z ostatnich 7 dni w celu kalorii. To bardziej liczy się niż jeden idealny dzień.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 of the last 7 days on calorie target. That counts more than one perfect day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "5 de los últimos 7 días en el objetivo de calorías. Eso vale más que un día perfecto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "5 из последних 7 дней в цели калорий. Это важнее одного идеального дня."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "5 із 7 днів у цільових калоріях. Це важливіше за один ідеальний день."
          }
        }
      }
    },
    "7 dni · pełne AI · brak limitów. Tap, żeby zobaczyć plany.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "7 days · full AI · no limits. Tap to see plans."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "7 días · IA completa · sin límites. Toca para ver los planes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "7 дней · полный ИИ · без лимитов. Тап, чтобы увидеть планы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "7 днів · повний ШІ · без лімітів. Тапніть, щоб переглянути плани."
          }
        }
      }
    },
