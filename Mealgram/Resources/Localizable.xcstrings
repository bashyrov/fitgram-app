    "Twaróg lub kazeina (≈30 g) dostarczają aminokwasów w długiej tonacji — 6–8 h. Wspierają syntezę białek w nocy, gdy nic nie jesz.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twaróg lub kazeina (≈30 g) dostarczają aminokwasów w długiej tonacji — 6–8 h. Wspierają syntezę białek w nocy, gdy nic nie jesz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twaróg (Polish curd cheese) or casein (≈30 g) drip-feeds amino acids over 6–8 h. Supports protein synthesis through the night while you fast."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кисломолочний сир чи казеїн (≈30 г) живлять амінокислотами 6–8 год. Підтримують синтез білка вночі, коли ти нічого не їси."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Творог или казеин (≈30 г) подают аминокислоты долгим капельным потоком 6–8 ч. Поддерживают синтез белка ночью, когда ничего не ешь."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Twaróg (requesón polaco) o caseína (≈30 g) gotean aminoácidos durante 6–8 h. Apoyan la síntesis proteica de noche cuando no comes."
          }
        }
      }
    },
    "Średnia tygodniowa = prawda": {
