    "+10% TDEE is enough to build ≈0.25 kg of muscle per month for advanced lifters, 0.5–0.7 kg for beginners. A larger surplus = more fat, not more muscle.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "+10% TDEE is enough to build ≈0.25 kg of muscle per month for advanced lifters, 0.5–0.7 kg for beginners. A larger surplus = more fat, not more muscle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "+10% de TDEE es suficiente para ganar ≈0.25 kg de músculo al mes para avanzados, y 0.5–0.7 kg para principiantes. Un excedente mayor = más grasa, no más músculo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "+10% TDEE wystarczy do zbudowania ≈0.25 kg mięśni miesięcznie dla zaawansowanych, 0.5–0.7 kg dla początkujących. Większy nadmiar = więcej tłuszczu, nie mięśni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "+10% TDEE достаточно для набора ≈0.25 кг мышц в месяц для опытных, 0.5–0.7 кг для новичков. Больший профицит = больше жира, а не мышц."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "+10% TDEE достатньо для побудови ≈0.25 кг м'язів на місяць для досвідчених атлетів, 0.5–0.7 кг для початківців. Більший профіцит = більше жиру, а не м'язів."
          }
        }
      }
    },
