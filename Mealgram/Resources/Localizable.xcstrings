        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya llevas %lld días seguidos con Mealgram. Un ritmo tranquilo — exactamente como debe ser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już %lld dni z rzędu z Mealgram. Spokojne tempo — dokładnie tak, jak powinno być."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже %lld дней подряд с Mealgram. Спокойный темп — именно так, как и должно быть."
