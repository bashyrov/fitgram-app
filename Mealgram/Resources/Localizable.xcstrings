    "Cardio at 60–70% HRmax (conversational pace) builds mitochondria and an aerobic base. Jog-walking, cycling without getting out of breath. 150 min/week is the standard.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardio at 60–70% HRmax (conversational pace) builds mitochondria and an aerobic base. Jog-walking, cycling without getting out of breath. 150 min/week is the standard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cardio al 60–70% de la FCmáx (ritmo conversacional) desarrolla mitocondrias y base aeróbica. Trote suave o bici sin ahogarse. El estándar son 150 min/semana."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardio na poziomie 60–70% HRmax (tempo konwersacyjne) buduje mitochondria i bazę tlenową. Truchtomarsz, jazda na rowerze bez zadyszki. Standard to 150 min/tydzień."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кардио при 60–70% HRmax (разговорный темп) развивает митохондрии и аэробную базу. Легкий бег, езда на велосипеде без одышки. 150 мин/неделю — это стандарт."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кардіо при 60–70% HRmax (розмовний темп) будує мітохондрії та аеробну базу. Легкий біг, їзда на велосипеді без задишки. 150 хв/тиждень — це стандарт."
          }
        }
      }
    },
    "Carrot": {
      "extractionState": "stale",
      "localizations": {
        "en": {
