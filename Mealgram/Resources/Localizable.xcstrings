    "Even one minute of standing per hour at a desk job lifts daily energy expenditure noticeably.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even one minute of standing per hour at a desk job lifts daily energy expenditure noticeably."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso un minuto de pie por hora en un trabajo de oficina aumenta notablemente el gasto energético diario."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawet minuta stania na godzinę przy pracy biurowej wyraźnie zwiększa dzienny wydatek energetyczny."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже одна минута стояния в час при сидячей работе заметно увеличивает расход энергии."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навіть одна хвилина стояння на годину при сидячій роботі помітно збільшує витрату енергії."
          }
        }
      }
    },
    "Everything is editable. This is just a demo — nothing is saved to Today yet.": {
      "extractionState": "manual",
