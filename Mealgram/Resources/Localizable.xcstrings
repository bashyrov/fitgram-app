    "Tie water to existing habits — one at wake-up, one at lunch, one at clock-out. Hitting %lld ml gets automatic.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tie water to existing habits — one at wake-up, one at lunch, one at clock-out. Hitting %lld ml gets automatic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asocia el agua a tus hábitos: un vaso al despertar, otro al almorzar y otro al salir de trabajar. Llegar a %lld ml se volverá automático."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiąż picie wody z nawykami — szklanka po przebudzeniu, do obiadu i po pracy. Cel %lld ml osiągniesz automatycznie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привяжите воду к привычкам: стакан после сна, в обед и после работы. Набрать %lld мл станет делом привычки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прив'яжіть воду до звичок: склянка після сну, в обід, після роботи. Досягти %lld мл стане автоматичним."
          }
        }
      }
    },
