    "Capsaicin from chili peppers increases thermogenesis in the short term. Realistically 30–50 kcal/day. Bonus — it acts as a mild appetite suppressant.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chilli capsaicin raises thermogenesis short-term. Realistically 30–50 kcal/day. Bonus — it mildly suppresses appetite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La capsaicina del chile sube la termogénesis a corto plazo. Realmente 30–50 kcal/día. Bonus — frena ligeramente el apetito."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapsaicyna z papryczek podnosi termogenezę krótkoterminowo. Realnie 30–50 kcal/dobę. Bonus — działa lekko apetyto-tłumiąco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Капсаицин из перца кратковременно повышает термогенез. Реально 30–50 ккал/сут. Бонус — слегка подавляет аппетит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Капсаїцин з перцю короткочасно підвищує термогенез. Реально 30–50 ккал/добу. Бонус — трохи притлумлює апетит."
          }
        }
      }
    },
