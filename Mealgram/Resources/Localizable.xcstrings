    "Just log for two weeks — no targets. The patterns you spot say more than any diet article.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just log for two weeks — no targets. The patterns you spot say more than any diet article."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo registra durante dos semanas, sin metas. Los patrones que descubras dicen más que cualquier artículo de dietas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po prostu zapisuj posiłki przez dwa tygodnie — bez żadnych celów. Wnioski, które wyciągniesz, dadzą Ci więcej niż jakikolwiek artykuł o dietach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просто ведите дневник две недели без целей. Замеченные вами закономерности скажут больше, чем любая статья о диетах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Просто записуйте їжу два тижні — без жодних цілей. Виявлені закономірності скажуть більше, ніж будь-яка стаття про дієти."
          }
        }
      }
    },
