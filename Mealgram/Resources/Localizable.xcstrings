    "Twoja waga zaktualizuje się w profilu, a my przeliczymy normy dzienne (jeśli nie są zablokowane).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your weight updates in the profile and we recalculate daily targets (unless locked)."
