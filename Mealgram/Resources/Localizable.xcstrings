            "state": "translated",
            "value": "1 kg of muscle = +13 kcal/day"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "1 кг м'язів = +13 ккал/добу"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1 кг мышц = +13 ккал/сут"
          }
        },
        "es": {
