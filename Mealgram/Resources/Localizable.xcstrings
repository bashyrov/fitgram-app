    "Select the goal \"Lose weight\" or \"Gain weight\" in Profile → Goals to activate tracking.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the goal \"Lose weight\" or \"Gain weight\" in Profile → Goals to activate tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona el objetivo \"Perder peso\" o \"Ganar peso\" en Perfil → Objetivos para activar el seguimiento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz cel „Schudnąć” lub „Przytyć” w Profil → Cele, aby aktywować śledzenie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите цель «Сбросить вес» или «Набрать вес» в Профиль → Цели, чтобы включить трекинг."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть ціль \"Схуднути\" або \"Набрати вагу\" у Профіль → Цілі, щоб увімкнути відстеження."
          }
        }
      }
    },
