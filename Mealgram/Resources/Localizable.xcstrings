    "Po pierwszym podsumowaniu tygodnia wszystkie wpisy pojawią się tu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the first weekly summary, all entries will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras el primer resumen semanal, todas las entradas aparecerán aquí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После первого недельного итога все записи появятся здесь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після першого тижневого підсумку всі записи з’являться тут."
          }
        }
      }
    },
    "Po południu, gdy nic nie wpisałeś, pojawia się przycisk freeze. Zużywa jeden z dwóch tygodniowych zapasów.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the afternoon, with nothing logged, a freeze button appears. It uses one of your two weekly freezes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por la tarde, si no registraste nada, aparece el botón freeze. Usa uno de tus dos freezes semanales."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Днём, если ничего не записано, появляется кнопка freeze. Тратит один из двух недельных запасов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після обіду, якщо нічого не записано, з’являється кнопка freeze. Використовує один із двох тижневих запасів."
          }
        }
      }
    },
    "Po prostu chcę widzieć, co jem": {
