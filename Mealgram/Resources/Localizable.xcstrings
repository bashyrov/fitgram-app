    "W ciągu 30 dni schudłaś %@. Konsekwencja popłaca — tak trzymać.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost %@ in 30 days. Consistency pays — keep it up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has perdido %@ en 30 días. La constancia funciona — sigue así."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За 30 дней ты сбросила %@. Постоянство работает — так держать."
          }
        },
