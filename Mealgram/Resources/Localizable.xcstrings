    "Wkrótce: Ola sama zamieni opis w wpis z kaloriami. Teraz zapisujemy placeholder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soon: Ola turns the description into a calorie entry herself. For now we save a placeholder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto: Ola convertirá la descripción en una entrada con calorías. Por ahora guardamos un marcador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скоро: Оля сама превратит описание в запись с калориями. Пока сохраняем плейсхолдер."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скоро: Оля сама перетворить опис на запис із калоріями. Зараз зберігаємо плейсхолдер."
          }
        }
      }
    },
    "Włącz dostęp do aparatu w Ustawieniach, żebyśmy mogli skanować posiłki ze zdjęć.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable camera access in Settings so we can scan meals from photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el acceso a la cámara en Ajustes para que podamos escanear comidas desde fotos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включи доступ к камере в Настройках, чтобы мы могли сканировать приёмы пищи с фото."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть доступ до камери в Налаштуваннях, щоб ми могли сканувати страви з фото."
          }
        }
      }
    },
    "Włącz mikrofon + rozpoznawanie mowy w Ustawieniach, żeby dyktować posiłki.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable microphone + speech recognition in Settings to dictate meals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa micrófono + reconocimiento de voz en Ajustes para dictar comidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включи микрофон + распознавание речи в Настройках, чтобы диктовать приёмы пищи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть мікрофон + розпізнавання мовлення в Налаштуваннях, щоб диктувати страви."
          }
        }
      }
    },
    "Włącz przypomnienia": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable reminders"
          }
        },
