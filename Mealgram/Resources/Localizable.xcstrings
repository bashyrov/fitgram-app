    "Wolniejsze tempo to zwykle trwalszy efekt. Możesz to zmienić później.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slower pace usually means longer-lasting results. You can change this later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ritmo más lento suele dar resultados más duraderos. Lo puedes cambiar luego."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более медленный темп обычно даёт более стойкий эффект. Это можно изменить позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повільніший темп зазвичай дає тривалішу віддачу. Це можна змінити пізніше."
          }
        }
      }
    },
