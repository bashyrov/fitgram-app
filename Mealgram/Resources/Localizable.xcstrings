    "Twaróg chudy (18 g/100 g), jajka (13 g/100 g), pierś z kurczaka (23 g/100 g), soczewica (9 g/100 g po ugotowaniu), tuńczyk z puszki (25 g).": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twaróg chudy (18 g/100 g), jajka (13 g/100 g), pierś z kurczaka (23 g/100 g), soczewica (9 g/100 g po ugotowaniu), tuńczyk z puszki (25 g)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low-fat twaróg (Polish curd cheese, 18 g/100 g), eggs (13 g), chicken breast (23 g), lentils cooked (9 g), canned tuna (25 g)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нежирний кисломолочний сир (18 г/100 г), яйця (13 г/100 г), куряча грудка (23 г/100 г), сочевиця (9 г/100 г варена), тунець з банки (25 г)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Творог обезжиренный (18 г/100 г), яйца (13 г/100 г), куриная грудка (23 г/100 г), чечевица (9 г/100 г варёная), тунец из банки (25 г)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Twaróg (requesón polaco) bajo en grasa (18 g/100 g), huevos (13 g), pechuga de pollo (23 g), lentejas cocidas (9 g), atún en lata (25 g)."
          }
        }
      }
    },
    "Deload co 4-6 tygodni": {
      "extractionState": "manual",
      "localizations": {
