    "Tak zobaczysz wyniki po realnym skanie. Wszystko da się poprawić.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is how results look after a real scan. Everything can be edited."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así verás los resultados tras un escaneo real. Todo se puede ajustar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так выглядят результаты после реального скана. Всё можно поправить."
