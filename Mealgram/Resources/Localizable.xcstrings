          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "150 g de pasta cocida = ~200 kcal. Medio plato de verduras y un puño de proteína lo mantiene equilibrado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "150 g ugotowanego makaronu = ~200 kcal. Pół talerza warzyw i garść białka zapewnią równowagę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "150 г готовых макарон = ~200 ккал. Половина тарелки овощей и горсть белка помогут сохранить баланс."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "150 г варених макаронів = ~200 ккал. Половина тарілки овочів і жменя білка збережуть баланс."
          }
        }
      }
    },
    "150 ml of dry red wine is ≈120 kcal. Sweet wine is +30%. From a weight loss perspective: 1 glass = 1 hour of walking. Choose mindfully.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "150 ml of dry red is ≈120 kcal. Sweet wine adds +30%. In cut terms: 1 glass = 1 hour of walking. Choose consciously."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "150 ml de tinto seco son ≈120 kcal. El vino dulce suma +30%. En definición: 1 copa = 1 hora de caminata. Elige con cabeza."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "150 ml czerwonego wytrawnego to ≈120 kcal. Słodkie wino +30%. Z perspektywy redukcji: 1 lampka = 1 godzina spaceru. Wybieraj świadomie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "150 мл сухого красного — ≈120 ккал. Сладкое вино +30%. В терминах редукции: 1 бокал = 1 час прогулки. Выбирай осознанно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "150 мл сухого червоного — ≈120 ккал. Солодке вино +30%. У термінах редукції: 1 келих = 1 година прогулянки. Обирай свідомо."
          }
        }
      }
    },
