    "5 dni po -400 kcal = -2000 kcal. Dwa dni po +1000 kcal = +2000 kcal. Bilans zerowy. Dlatego waga „nie spada”, mimo idealnego poniedziałku.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "5 dni po -400 kcal = -2000 kcal. Dwa dni po +1000 kcal = +2000 kcal. Bilans zerowy. Dlatego waga „nie spada”, mimo idealnego poniedziałku."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 days at -400 kcal = -2000 kcal. Two days at +1000 kcal = +2000 kcal. Net zero. That's why the scale \"won't budge\" despite a perfect Monday."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "5 днів по -400 ккал = -2000 ккал. Два дні по +1000 ккал = +2000 ккал. Баланс нульовий. Тому вага «не падає», незважаючи на ідеальний понеділок."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "5 дней по -400 ккал = -2000 ккал. Два дня по +1000 ккал = +2000 ккал. Баланс нулевой. Поэтому вес «не падает», несмотря на идеальный понедельник."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "5 días a -400 kcal = -2000 kcal. Dos días a +1000 kcal = +2000 kcal. Balance cero. Por eso la báscula \"no baja\" pese al lunes perfecto."
          }
        }
      }
    },
