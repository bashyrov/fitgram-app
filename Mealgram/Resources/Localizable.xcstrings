    "5 floors a day = ~50 kcal extra plus a quad workout. Small habits compound across the year.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 floors a day = ~50 kcal extra plus a quad workout. Small habits compound across the year."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "5 pisos al día = ~50 kcal extra más entrenamiento de piernas. Los pequeños hábitos suman a lo largo del año."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "5 pięter dziennie = ~50 kcal ekstra i trening czwórogłowych. Małe nawyki dają wielkie efekty w skali roku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "5 этажей в день = ~50 ккал плюс тренировка квадрицепсов. Мелкие привычки накапливаются за год."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "5 поверхів на день = ~50 додаткових ккал плюс тренування квадрицепсів. Маленькі звички накопичуються протягом року."
          }
        }
      }
    },
    "5 g of monohydrate daily, every day, without loading. It gives 3–5% more strength and fuller muscles. The most thoroughly researched supplement in sports history.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 g of monohydrate daily, every day, without loading. It gives 3–5% more strength and fuller muscles. The most thoroughly researched supplement in sports history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "5 g de monohidrato al día, cada día, sin fase de carga. Da un 3–5% más de fuerza y músculos más llenos. El suplemento más investigado en la historia del deporte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "5 g monohydratu dziennie, każdego dnia, bez fazy nasycenia. Daje 3–5% więcej siły i pełniejsze mięśnie. Najlepiej przebadany suplement w historii sportu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "5 г моногидрата ежедневно, каждый день, без фазы загрузки. Это дает на 3–5% больше силы и делает мышцы более наполненными. Самая изученная добавка в истории спорта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "5 г моногідрату щодня, без фази завантаження. Це дає на 3–5% більше сили та повніші м'язи. Найбільш ретельно досліджена добавка в історії спорту."
          }
        }
      }
    },
