    "All challenges run in parallel. You don't have to choose anything — every meal counts on its own.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All challenges run in parallel. You don’t pick anything — every meal counts on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los retos corren a la vez. No eliges nada — cada comida cuenta por sí sola."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie wyzwania działają równolegle. Nic nie wybierasz — każdy posiłek liczy się sam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все челленджи идут параллельно. Ничего не выбираешь — каждый приём пищи засчитывается сам."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі виклики йдуть паралельно. Нічого не обираєш — кожна страва зараховується сама."
          }
        }
      }
    },
    "All good — you don't have to pick anything.": {
