    "Kobiety 320, mężczyźni 420 mg. Niedobór = skurcze, bezsenność, kołatanie serca. Pestki dyni (550 mg/100 g), kakao, migdały, gorzka czekolada.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobiety 320, mężczyźni 420 mg. Niedobór = skurcze, bezsenność, kołatanie serca. Pestki dyni (550 mg/100 g), kakao, migdały, gorzka czekolada."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Women 320, men 420 mg. Deficiency = cramps, insomnia, palpitations. Pumpkin seeds (550 mg/100 g), cocoa, almonds, dark chocolate."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жінки 320, чоловіки 420 мг. Дефіцит = судоми, безсоння, серцебиття. Гарбузове насіння (550 мг/100 г), какао, мигдаль, чорний шоколад."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Женщины 320, мужчины 420 мг. Дефицит = судороги, бессонница, сердцебиение. Тыквенные семечки (550 мг/100 г), какао, миндаль, тёмный шоколад."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mujeres 320, hombres 420 mg. Déficit = calambres, insomnio, palpitaciones. Pipas de calabaza (550 mg/100 g), cacao, almendras, chocolate negro."
          }
        }
      }
    },
