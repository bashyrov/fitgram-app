    "Cele zapisane, przypomnienia gotowe. Wpisz pierwszy posiłek — Ola podpowie resztę.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goals saved, reminders ready. Add your first meal — Ola will guide you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivos guardados, recordatorios listos. Añade tu primera comida — Ola te guiará."
