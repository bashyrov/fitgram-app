    "Pale yellow = hydrated. Dark like amber = drink. The first morning one is always darker. An easier indicator than counting glasses.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pale yellow = hydrated. Dark amber = drink up. The first morning one is always darker. Easier indicator than counting glasses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amarillo pálido = hidratado. Ámbar oscuro = bebe. La primera de la mañana siempre es más oscura. Indicador más fácil que contar vasos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasnożółty = nawodniony. Ciemny jak bursztyn = pij. Pierwszy poranny zawsze ciemniejszy. Łatwiejszy wskaźnik niż liczenie szklanek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светло-жёлтый = ты гидратирован. Тёмно-янтарный = пей. Первый утренний всегда темнее. Проще показатель, чем считать стаканы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Світло-жовтий = ти зволожений. Темно-бурштиновий = пий. Перший ранковий завжди темніший. Простіший показник, ніж рахувати склянки."
          }
        }
      }
    },
