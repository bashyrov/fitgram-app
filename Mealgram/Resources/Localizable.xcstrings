    "When the 4 PM snack craving hits, try a tall glass of water first. Many 'hunger' signals dissolve in 10 minutes.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the 4 PM snack craving hits, try a tall glass of water first. Many 'hunger' signals dissolve in 10 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando te dé el antojo de picar a las 4 PM, prueba primero con un vaso grande de agua. Muchas señales de \"hambre\" desaparecen en 10 minutos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy o 16:00 dopadnie Cię ochota na przekąskę, wypij najpierw szklankę wody. Często sygnał głodu znika po 10 minutach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда в 16:00 хочется перекусить, сначала выпейте стакан воды. Многие сигналы «голода» исчезают через 10 минут."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли о 16:00 хочеться перекусити, спочатку випийте склянку води. Багато сигналів «голоду» зникають за 10 хвилин."
          }
        }
      }
    },
