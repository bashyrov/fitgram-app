    "Szklanka mleka = 240 mg, plasterek żółtego sera = 200 mg, garść migdałów = 75 mg. Po 50 r.ż. zapotrzebowanie rośnie do 1200 mg.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szklanka mleka = 240 mg, plasterek żółtego sera = 200 mg, garść migdałów = 75 mg. Po 50 r.ż. zapotrzebowanie rośnie do 1200 mg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A glass of milk = 240 mg, a slice of hard cheese = 200 mg, a handful of almonds = 75 mg. After 50, the need rises to 1200 mg."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Склянка молока = 240 мг, скибочка твердого сиру = 200 мг, жменя мигдалю = 75 мг. Після 50 років потреба зростає до 1200 мг."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стакан молока = 240 мг, ломтик твёрдого сыра = 200 мг, горсть миндаля = 75 мг. После 50 лет потребность растёт до 1200 мг."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vaso de leche = 240 mg, una loncha de queso curado = 200 mg, un puñado de almendras = 75 mg. Tras los 50 sube a 1200 mg."
          }
        }
      }
    },
