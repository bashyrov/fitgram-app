          }
        }
      }
    },
    "Wszystko w jednym miejscu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All in one place"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo en un solo lugar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё в одном месте"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе в одному місці"
          }
        }
      }
    },
    "Wszystko wygląda zdrowo. Nie zapominaj o wodzie — to często prosty brakujący puzzel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything looks healthy. Don’t forget water — often the missing puzzle piece."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se ve sano. No olvides el agua — suele ser la pieza que falta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё выглядит здорово. Не забывай про воду — часто это простой недостающий пазл."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе виглядає добре. Не забувай про воду — часто це простий пропущений пазл."
          }
        }
      }
    },
    "Wybierz cel \"Zrzucić wagę\" lub \"Przybrać na wadze\" w Profilu → Cele, żeby aktywować śledzenie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick \"Lose weight\" or \"Gain weight\" in Profile → Goals to activate tracking."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть «Схуднути» або «Набрати вагу» у Профілі → Цілі, щоб активувати відстеження."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери «Похудеть» или «Набрать вес» в Профиле → Цели, чтобы активировать отслеживание."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige \"Perder peso\" o \"Ganar peso\" en Perfil → Objetivos para activar el seguimiento."
          }
        }
      }
    },
    "wybierz chleb bezglutenowy oznaczony przekreślonym kłosem": {
