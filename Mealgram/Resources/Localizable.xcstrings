          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteína vegetal — combina para completar"
          }
        }
      }
    },
    "Pojedyncze rośliny rzadko mają pełen profil aminokwasów. Zboża + rośliny strączkowe (ryż + fasola, hummus + chleb) tworzą komplementarną parę.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojedyncze rośliny rzadko mają pełen profil aminokwasów. Zboża + rośliny strączkowe (ryż + fasola, hummus + chleb) tworzą komplementarną parę."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Single plants rarely have a full amino-acid profile. Grains + legumes (rice + beans, hummus + bread) make a complementary pair."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одиночні рослини рідко мають повний профіль амінокислот. Зернові + бобові (рис + квасоля, хумус + хліб) утворюють комплементарну пару."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельные растения редко имеют полный профиль аминокислот. Злаки + бобовые (рис + фасоль, хумус + хлеб) — комплементарная пара."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantas por sí solas raramente tienen perfil completo de aminoácidos. Cereales + legumbres (arroz + alubias, hummus + pan) forman pareja complementaria."
          }
        }
      }
    },
