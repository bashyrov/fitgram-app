          }
        }
      }
    },
    "Pierwsze 6–12 mies trening + 1.6 g białka na maintenance daje jednocześnie spadek tłuszczu i wzrost mięśni. Dla zaawansowanych — niemożliwe.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsze 6–12 mies trening + 1.6 g białka na maintenance daje jednocześnie spadek tłuszczu i wzrost mięśni. Dla zaawansowanych — niemożliwe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the first 6–12 months, training + 1.6 g protein/kg on maintenance brings fat loss and muscle gain at the same time. For advanced lifters — impossible."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перші 6–12 міс. тренування + 1,6 г білка на підтримці дають водночас зниження жиру і ріст м'язів. Для досвідчених — неможливо."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первые 6–12 мес тренировки + 1,6 г белка на поддержании дают одновременно падение жира и рост мышц. У продвинутых — невозможно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los primeros 6–12 meses, entrenar + 1,6 g de proteína/kg en mantenimiento da pérdida de grasa y ganancia de músculo a la vez. Para avanzados — imposible."
          }
        }
      }
    },
    "RIR 1-3 dla hipertrofii": {
      "extractionState": "manual",
      "localizations": {
