    "Twoja seria %lld dni — jeszcze nic dziś nie zapisałaś. Krótki wpis wystarczy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %lld-day streak — nothing logged today yet. A short entry is enough."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu racha de %lld días — aún no registraste nada hoy. Con una entrada corta basta."
