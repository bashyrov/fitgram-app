    "Medium egg: 6 g of protein, 70 kcal. Milk 200 ml: 7 g. Cottage cheese 100 g: 18 g. Chicken breast 100 g: 23 g. Canned tuna: 25 g.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A medium egg: 6 g protein, 70 kcal. 200 ml milk: 7 g. 100 g twaróg (Polish curd cheese): 18 g. 100 g chicken breast: 23 g. Tuna can: 25 g."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un huevo mediano: 6 g de proteína, 70 kcal. 200 ml de leche: 7 g. 100 g de twaróg (requesón polaco): 18 g. 100 g de pechuga de pollo: 23 g. Una lata de atún: 25 g."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Średnie jajko: 6 g białka, 70 kcal. Mleko 200 ml: 7 g. Twaróg 100 g: 18 g. Pierś z kurczaka 100 g: 23 g. Tuńczyk puszka: 25 g."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Среднее яйцо: 6 г белка, 70 ккал. Молоко 200 мл: 7 г. Творог 100 г: 18 г. Куриная грудка 100 г: 23 г. Тунец из банки: 25 г."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Середнє яйце: 6 г білка, 70 ккал. Молоко 200 мл: 7 г. Кисломолочний сир 100 г: 18 г. Куряча грудка 100 г: 23 г. Тунець з банки: 25 г."
          }
        }
      }
    },
    "Men 11 mg, women 8 mg. Oysters reign supreme (78 mg/100 g!), followed by liver, pumpkin seeds, beef. Supports immunity and testosterone synthesis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Men 11, women 8 mg. Oysters dominate (78 mg/100 g!), then liver, pumpkin seeds, beef. Supports immunity and testosterone synthesis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hombres 11, mujeres 8 mg. Las ostras lideran (78 mg/100 g!), luego hígado, pipas de calabaza, ternera. Apoya inmunidad y síntesis de testosterona."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mężczyźni 11, kobiety 8 mg. Ostrygi królują (78 mg/100 g!), potem wątroba, pestki dyni, mięso wołowe. Wspiera odporność i syntezę testosteronu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мужчины 11, женщины 8 мг. Лидируют устрицы (78 мг/100 г!), затем печень, тыквенные семечки, говядина. Поддерживает иммунитет и синтез тестостерона."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чоловіки 11, жінки 8 мг. Лідирують устриці (78 мг/100 г!), далі печінка, гарбузове насіння, яловичина. Підтримує імунітет і синтез тестостерону."
          }
        }
      }
    },
